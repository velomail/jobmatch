NEXT_PUBLIC_SITE_URL=https://jobmatch.ca
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Auth (Clerk) — replace the local email session
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database
DATABASE_URL=

# Resume files
BLOB_READ_WRITE_TOKEN=

# Rate limits — APIs always cap by IP in memory. Set these for shared limits across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Billing — Founding Pro is $9/month (not $9/day)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PRICE_ID=
STRIPE_FOUNDING_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI — server only. Never prefix with NEXT_PUBLIC_ (that would leak the key to the browser).
# Get a key at https://platform.openai.com/api-keys
# Copy into .env.local (gitignored), not this file.
#
# Uses:
#   1) Parse a resume into a structured profile the user can confirm
#   2) Rerank ~50 real jobs into the weekly Top 10
# Do not generate listings with this key. Jobs come from ingest below.
OPENAI_API_KEY=
OPENAI_PARSE_MODEL=gpt-4.1-mini
OPENAI_RERANK_MODEL=gpt-4.1

# Optional: Vercel AI Gateway instead of calling OpenAI directly
# https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=

# Job ingest (cron: app/api/cron/ingest) — real postings only
# Adzuna CA: https://developer.adzuna.com
# Store the employer careers URL as canonical_url. Source (LinkedIn/Indeed/Company site) is a label only.
# Never persist or open LinkedIn/Indeed apply links. No HTML scrape of those sites.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Indeed via HasData (server only). Discovery only — apply links stay on employer career pages.
# https://docs.hasdata.com/apis/indeed/listing
HASDATA_API_KEY=
HASDATA_INDEED_DOMAIN=ca.indeed.com

# Public ATS boards (JSON, not scrapers). Comma-separated board/org slugs.
# Greenhouse: boards-api.greenhouse.io/v1/boards/{slug}/jobs
# Lever: api.lever.co/v0/postings/{slug}
# Ashby: jobs.ashbyhq.com/{slug}/published
GREENHOUSE_BOARD_SLUGS=
LEVER_SITE_SLUGS=
ASHBY_ORG_SLUGS=

# Email + push. VAPID public key is fetched by the app; private key stays on the server.
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
